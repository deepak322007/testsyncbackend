PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/cropcare
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
OTP_EXPIRES_MINUTES=5
OTP_COOLDOWN_SECONDS=60
NODE_ENV=development
# Set to true only when using a real SMS provider.
SMS_ENABLED=false
# Optional Twilio configuration for production SMS delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
